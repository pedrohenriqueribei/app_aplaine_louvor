rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Secure Admin check: Only check if document exists before getting data
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'líder';
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      // Allow partial updates if the merged result is valid
      let requiredFields = ['uid', 'name', 'email', 'role', 'status'];
      return data.keys().hasAll(requiredFields) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['líder', 'instrumentista'] &&
             data.status in ['active', 'inactive'] &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
             (!('vocalRange' in data) || (data.vocalRange is string)) &&
             (!('level' in data) || (data.level is string)) &&
             (!('churchId' in data) || (data.churchId is string)) &&
             (!('instruments' in data) || (data.instruments is list && data.instruments.size() <= 50));
    }

    function isValidSong(data) {
      let requiredFields = ['id', 'title', 'artist', 'key', 'link', 'ownerId', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredFields) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.artist is string && data.artist.size() <= 200 &&
             data.key is string && data.key.size() <= 20 &&
             data.link is string && data.link.size() <= 500 &&
             data.ownerId == request.auth.uid &&
             (!('sheet' in data) || (data.sheet is string && data.sheet.size() <= 10000)) &&
             (!('bpm' in data) || (data.bpm is string && data.bpm.size() <= 10)) &&
             (!('timeSignature' in data) || (data.timeSignature is string && data.timeSignature.size() <= 20)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
             (!('observations' in data) || (data.observations is string && data.observations.size() <= 2000));
    }

    // --- Match Blocks ---

    match /users/{userId} {
      // Split read into get and list for better security and performance
      allow get: if isSignedIn() && (
        isOwner(userId) || 
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId == get(/databases/$(database)/documents/users/$(userId)).data.churchId)
      );

      allow list: if isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         resource.data.churchId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId)
      );
      
      allow create: if (isOwner(userId) || isAdmin()) && 
        isValidId(userId) &&
        isValidUser(incoming()) &&
        (isOwner(userId) ? (
          incoming().uid == userId &&
          incoming().email == request.auth.token.email &&
          (incoming().role == 'instrumentista' || (incoming().role == 'líder' && incoming().email == 'pedrohenriqueribei@gmail.com'))
        ) : true);
      
      allow update: if (isOwner(userId) || isAdmin()) && 
        isValidId(userId) && 
        isValidUser(incoming()) && (
          isAdmin() || (
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().email == existing().email &&
            incoming().uid == existing().uid
          )
        );

      allow delete: if isAdmin();
    }

    match /churches/{churchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /songs/{songId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(songId) && isValidSong(incoming()) && 
                    incoming().id == songId && incoming().createdAt == request.time && 
                    incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(songId) && resource.data.ownerId == request.auth.uid && 
                    isValidSong(incoming()) && incoming().createdAt == existing().createdAt && 
                    incoming().updatedAt == request.time && incoming().ownerId == existing().ownerId &&
                    incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(songId) && resource.data.ownerId == request.auth.uid;
    }

    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
