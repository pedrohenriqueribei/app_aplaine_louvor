rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Secure user data helper: Handles missing user document gracefully
    function myData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {"role": "", "churchId": ""};
    }

    function isAdmin() {
      return isSignedIn() && 
             (
               request.auth.token.email == 'pedrohenriqueribei@gmail.com' ||
               myData().get('role', '') == 'líder'
             );
    }

    function getMyChurch() {
      return myData().get('churchId', '');
    }

    function isValidNotification(data) {
      let requiredFields = ['id', 'userId', 'title', 'body', 'type', 'read', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.id is string &&
             data.userId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.body is string && data.body.size() <= 1000 &&
             data.type is string &&
             data.read is bool;
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      // Allow partial updates if the merged result is valid
      let requiredFields = ['uid', 'name', 'email', 'role', 'status'];
      return data.keys().hasAll(requiredFields) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 100 &&
             data.role in ['líder', 'instrumentista'] &&
             data.status in ['active', 'inactive'] &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
             (!('vocalRange' in data) || (data.vocalRange is string)) &&
             (!('level' in data) || (data.level is string)) &&
             (!('churchId' in data) || (data.churchId is string)) &&
             (!('instruments' in data) || (data.instruments is list && data.instruments.size() <= 60));
    }

    function isValidSong(data) {
      let requiredFields = ['id', 'title', 'artist', 'key', 'link', 'ownerId', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredFields) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.artist is string && data.artist.size() > 0 && data.artist.size() <= 200 &&
             data.key is string && data.key.size() > 0 && data.key.size() <= 20 &&
             data.link is string && data.link.size() > 0 && data.link.size() <= 500 &&
             data.ownerId == request.auth.uid &&
             (!('churchId' in data) || (data.churchId is string)) &&
             (!('sheet' in data) || (data.sheet is string && data.sheet.size() <= 10000)) &&
             (!('bpm' in data) || (data.bpm is string && data.bpm.size() <= 10)) &&
             (!('timeSignature' in data) || (data.timeSignature is string && data.timeSignature.size() <= 20)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
             (!('observations' in data) || (data.observations is string && data.observations.size() <= 2000));
    }

    // --- Match Blocks ---

    match /users/{userId} {
      allow get: if isSignedIn() && (
        isOwner(userId) || 
        isAdmin() || 
        resource.data.get('churchId', '') == getMyChurch()
      );

      allow list: if isSignedIn() && (
        isAdmin() || 
        resource.data.get('churchId', '') == getMyChurch() ||
        (myData().get('role', '') == 'líder' && resource.data.get('churchId', '') == '')
      );
      
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin()) && 
        isValidId(userId) &&
        isValidUser(incoming()) && (
          isAdmin() || (
            isOwner(userId) &&
            incoming().uid == userId &&
            incoming().email == request.auth.token.email &&
            (incoming().role == 'instrumentista' || (incoming().role == 'líder' && incoming().email == 'pedrohenriqueribei@gmail.com'))
          )
        );
      
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && 
        isValidId(userId) && 
        isValidUser(incoming()) && (
          isAdmin() || (
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().email == existing().email &&
            incoming().uid == existing().uid
          )
        );

      allow delete: if isAdmin();
    }

    match /churches/{churchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /songs/{songId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin() ||
        (resource.data.get('churchId', '') != '' && resource.data.get('churchId', '') == getMyChurch())
      );
      
      allow create: if isSignedIn() && isValidId(songId) && isValidSong(incoming()) && 
                    incoming().id == songId && incoming().createdAt == request.time && 
                    incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(songId) && resource.data.ownerId == request.auth.uid && 
                    isValidSong(incoming()) && incoming().createdAt == existing().createdAt && 
                    incoming().updatedAt == request.time && incoming().ownerId == existing().ownerId &&
                    incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(songId) && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /fcm_tokens/{tokenId} {
      allow read, write: if isSignedIn() && (tokenId == request.auth.uid || isAdmin());
    }

    match /availability/{availId} {
      function isValidAvailability(data) {
        let requiredFields = ["id", "userId", "churchId", "month", "year", "days"];
        return data.keys().hasAll(requiredFields) &&
               data.id is string &&
               data.userId == request.auth.uid &&
               data.churchId is string &&
               data.month is int &&
               data.year is int &&
               data.days is list;
      }

      allow get: if isSignedIn() && (
        availId.split('_')[0] == request.auth.uid || 
        isAdmin() ||
        (resource != null && resource.data.churchId == getMyChurch())
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.churchId == getMyChurch() ||
        resource.data.userId == request.auth.uid
      );
      
      allow write: if isSignedIn() && isValidAvailability(incoming()) && 
                    (availId == incoming().id);
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) &&
                    isValidNotification(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
                    incoming().id == existing().id &&
                    incoming().userId == existing().userId;
      allow create, delete: if isAdmin();
    }
  }
}
