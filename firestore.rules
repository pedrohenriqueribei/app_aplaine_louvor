rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource != null ? request.resource.data : {};
    }

    function existing() {
      return resource != null ? resource.data : {};
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function myEmail() {
      return (isSignedIn() && 'email' in request.auth.token) ? request.auth.token.email : '';
    }

    function myData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(path) ? get(path).data : {};
    }

    function myChurch() {
      return myData().get('churchId', '');
    }

    function hasChurch() {
      return isSignedIn() && myChurch() != '';
    }

    function inChurch(churchId) {
      return hasChurch() && churchId is string && churchId != '' && myChurch() == churchId;
    }

    function myRoles() {
      return myData().get('roles', {});
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (('super_admin' in request.auth.token) && request.auth.token.super_admin == true) ||
        myEmail() == 'pedrohenriqueribei@gmail.com' ||
        myData().get('role', '') == 'super_admin' ||
        myData().get('super_admin', false) == true
      );
    }

    function leaderRoles() {
      return ['leader', 'main_minister', 'mainMinister', 'multimedia_leader', 'dance_leader'];
    }

    function isLeader() {
      return isSignedIn() && (
        isSuperAdmin() ||
        myData().get('role', '') in ['líder', 'pastor', 'pastor_titular', 'pastor_auxiliar'] ||
        myRoles().get('worship', []).hasAny(leaderRoles()) ||
        myRoles().get('multimedia', []).hasAny(leaderRoles()) ||
        myRoles().get('secretariat', []).hasAny(leaderRoles()) ||
        myRoles().get('dance', []).hasAny(leaderRoles()) ||
        myRoles().get('tesouraria', []).hasAny(leaderRoles()) ||
        myRoles().get('treasury', []).hasAny(leaderRoles())
      );
    }

    function leadsChurch(churchId) {
      return isSuperAdmin() || (isLeader() && inChurch(churchId));
    }

    function grantsLeadership(rolesMap) {
      return rolesMap.get('worship', []).hasAny(leaderRoles()) ||
             rolesMap.get('multimedia', []).hasAny(leaderRoles()) ||
             rolesMap.get('secretariat', []).hasAny(leaderRoles()) ||
             rolesMap.get('dance', []).hasAny(leaderRoles());
    }

    // --- Validation helpers ---

    function isValidUser(data) {
      return (!('uid' in data) || (data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128)) &&
             (!('status' in data) || data.status in ['active', 'inactive']) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
             (!('pastoralTitle' in data) || (data.pastoralTitle is string && data.pastoralTitle.size() <= 100)) &&
             (!('dataNascimento' in data) || data.dataNascimento == null || data.dataNascimento is timestamp || (data.dataNascimento is string && data.dataNascimento.size() <= 20)) &&
             (!('vocalRange' in data) || (data.vocalRange is string)) &&
             (!('level' in data) || (data.level is string)) &&
             (!('churchId' in data) || (data.churchId is string)) &&
             (!('role' in data) || (data.role is string)) &&
             (!('roles' in data) || (data.roles is map)) &&
             (!('instruments' in data) || (data.instruments is list && data.instruments.size() <= 60)) &&
             (!('danceStyles' in data) || (data.danceStyles is list && data.danceStyles.size() <= 60)) &&
             (!('danceGroups' in data) || (data.danceGroups is list && data.danceGroups.size() <= 60)) &&
             (!('fcmTokens' in data) || (data.fcmTokens is list && data.fcmTokens.size() <= 50)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 200000)) &&
             (!('notificationSettings' in data) || (data.notificationSettings is map)) &&
             (!('emailVerified' in data) || data.emailVerified is bool) &&
             (!('email_verified' in data) || data.email_verified is bool) &&
             (!('emailVerifiedAt' in data) || data.emailVerifiedAt is string || data.emailVerifiedAt is timestamp) &&
             (!('updatedAt' in data) || (data.updatedAt is string || data.updatedAt is timestamp)) &&
             (!('createdAt' in data) || (data.createdAt is string || data.createdAt is timestamp));
    }

    function isValidSong(data) {
      let requiredFields = ['id', 'title', 'artist', 'key', 'link', 'ownerId', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredFields) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.artist is string && data.artist.size() > 0 && data.artist.size() <= 200 &&
             data.key is string && data.key.size() > 0 && data.key.size() <= 20 &&
             data.link is string && data.link.size() > 0 && data.link.size() <= 500 &&
             data.ownerId == request.auth.uid &&
             (!('churchId' in data) || (data.churchId is string)) &&
             (!('sheet' in data) || (data.sheet is string && data.sheet.size() <= 10000)) &&
             (!('bpm' in data) || (data.bpm is string && data.bpm.size() <= 10)) &&
             (!('timeSignature' in data) || (data.timeSignature is string && data.timeSignature.size() <= 20)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
             (!('observations' in data) || (data.observations is string && data.observations.size() <= 2000));
    }

    function isValidSchedule(data) {
      return data.keys().hasAll(['id', 'date', 'churchId', 'songs', 'members', 'roles']) &&
             data.id is string &&
             data.date is string &&
             data.churchId is string &&
             data.songs is list &&
             data.members is list &&
             data.roles is map &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
             (!('multimediaNotes' in data) || (data.multimediaNotes is string && data.multimediaNotes.size() <= 5000));
    }

    function isValidPlaylist(data) {
      return data.keys().hasAll(['id', 'scheduleId', 'churchId', 'songs']) &&
             data.id is string &&
             data.scheduleId is string &&
             data.churchId is string &&
             data.songs is list;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'body', 'type', 'read', 'createdAt']) &&
             data.id is string &&
             data.userId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.body is string && data.body.size() <= 1000 &&
             data.type is string &&
             data.read is bool;
    }

    match /churches/{churchId} {
      allow read: if isSuperAdmin() || inChurch(churchId);
      allow create: if isSuperAdmin();
      allow update: if leadsChurch(churchId);
      allow delete: if isSuperAdmin();

      match /departments/{departmentId} {
        allow read: if isSuperAdmin() || inChurch(churchId);
        allow write: if leadsChurch(churchId);

        match /members/{memberUid} {
          function isValidMember(data) {
            return data.keys().hasAll(['userId', 'roles']) &&
                   data.userId is string &&
                   data.roles is list && data.roles.size() <= 20 &&
                   (!('danceStyles' in data) || (data.danceStyles is list && data.danceStyles.size() <= 60)) &&
                   (!('joinedAt' in data) || data.joinedAt is string || data.joinedAt is timestamp);
          }

          allow read: if isSuperAdmin() ||
                         memberUid == request.auth.uid ||
                         inChurch(churchId);

          allow create: if isValidMember(incoming()) &&
                        incoming().userId == memberUid && (
                          leadsChurch(churchId) ||
                          (isOwner(memberUid) &&
                           inChurch(churchId) &&
                           !incoming().roles.hasAny(leaderRoles()))
                        );

          allow update: if isValidMember(incoming()) &&
                        incoming().userId == existing().userId && (
                          leadsChurch(churchId) ||
                          (isOwner(memberUid) &&
                           inChurch(churchId) &&
                           !incoming().roles.hasAny(leaderRoles()) &&
                           !existing().roles.hasAny(leaderRoles()))
                        );

          allow delete: if leadsChurch(churchId);
        }
      }

      match /financial_records/{recordId} {
        allow read: if isSuperAdmin() || leadsChurch(churchId);
        allow create: if isSuperAdmin() || leadsChurch(churchId);
        allow update: if isSuperAdmin() || leadsChurch(churchId);
        allow delete: if isSuperAdmin() || leadsChurch(churchId);
      }
    }

    match /users/{userId} {
      allow read: if isSuperAdmin() ||
                     isOwner(userId) ||
                     (hasChurch() && existing().get('churchId', '') == myChurch());

      allow create: if isValidUser(incoming()) && (
        isSuperAdmin() ||
        (isLeader() && inChurch(incoming().get('churchId', ''))) ||
        (isOwner(userId) &&
         incoming().uid == userId &&
         incoming().get('role', '') != 'líder' &&
         incoming().get('role', '') != 'super_admin' &&
         !grantsLeadership(incoming().get('roles', {})))
      );

      allow update: if isValidUser(incoming()) && (
        isSuperAdmin() ||
        (isLeader() &&
         (existing().get('churchId', '') == myChurch() || existing().get('churchId', '') == '') &&
         (incoming().get('churchId', '') == myChurch() || incoming().get('churchId', '') == '')) ||
        (isOwner(userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['fcmTokens', 'notificationSettings', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'fcmTokens', 'notificationSettings', 'name', 'phone', 'dataNascimento', 'instruments',
            'vocalRange', 'danceStyles', 'danceGroups', 'level', 'photoURL', 'updatedAt', 'uid',
            'emailVerified', 'email_verified', 'emailVerifiedAt'
          ]) ||
          (
            existing().get('churchId', '') == '' &&
            !grantsLeadership(incoming().get('roles', {})) &&
            incoming().get('role', '') != 'líder' &&
            incoming().get('role', '') != 'super_admin'
          )
        ))
      );

      allow delete: if isSuperAdmin() ||
                    (isLeader() && inChurch(existing().get('churchId', '')));
    }

    // 3. Repertório Musical: Isolamento por congregação ou criador
    match /songs/{songId} {
      allow read: if isSuperAdmin() ||
                     (isSignedIn() && existing().ownerId == request.auth.uid) ||
                     (hasChurch() && (existing().get('churchId', '') == myChurch() || existing().get('churchId', '') == ''));

      allow create: if isSignedIn() && isValidId(songId) && isValidSong(incoming()) &&
                    incoming().id == songId &&
                    incoming().ownerId == request.auth.uid &&
                    (isSuperAdmin() || inChurch(incoming().get('churchId', ''))) &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isValidId(songId) && isValidSong(incoming()) &&
                    existing().ownerId == request.auth.uid &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().id == existing().id &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    incoming().get('churchId', '') == existing().get('churchId', '');

      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperAdmin());
    }

    // 4. Cultos
    match /services/{serviceId} {
      allow read: if isSuperAdmin() ||
                     inChurch(existing().get('churchId', '')) ||
                     serviceId.matches('^(worship|multimedia)_scale_config_.+');
      allow create: if leadsChurch(incoming().get('churchId', ''));
      allow update: if leadsChurch(existing().get('churchId', '')) &&
                    incoming().get('churchId', '') == existing().get('churchId', '');
      allow delete: if leadsChurch(existing().get('churchId', ''));
    }

    // 5. Bandas
    match /bands/{bandId} {
      allow read: if isSuperAdmin() || inChurch(existing().get('churchId', ''));
      allow create: if leadsChurch(incoming().get('churchId', ''));
      allow update: if leadsChurch(existing().get('churchId', '')) &&
                    incoming().get('churchId', '') == existing().get('churchId', '');
      allow delete: if leadsChurch(existing().get('churchId', ''));
    }

    // 6. Dança: Grupos, Coreografias, Ensaios
    match /dance_groups/{groupId} {
      allow read: if isSuperAdmin() || inChurch(existing().get('churchId', ''));
      allow create: if leadsChurch(incoming().get('churchId', ''));
      allow update: if leadsChurch(existing().get('churchId', '')) &&
                    incoming().get('churchId', '') == existing().get('churchId', '');
      allow delete: if leadsChurch(existing().get('churchId', ''));
    }

    match /choreographies/{choreographyId} {
      allow read: if isSuperAdmin() || inChurch(existing().get('churchId', ''));
      allow create: if isSignedIn() && (leadsChurch(incoming().get('churchId', '')) || inChurch(incoming().get('churchId', '')));
      allow update: if isSignedIn() && (leadsChurch(existing().get('churchId', '')) || inChurch(existing().get('churchId', ''))) &&
                    incoming().get('churchId', '') == existing().get('churchId', '');
      allow delete: if isSignedIn() && leadsChurch(existing().get('churchId', ''));
    }

    match /dance_rehearsals/{rehearsalId} {
      allow read: if isSuperAdmin() || inChurch(existing().get('churchId', ''));
      allow create: if isSignedIn() && (leadsChurch(incoming().get('churchId', '')) || inChurch(incoming().get('churchId', '')));
      allow update: if isSignedIn() && (leadsChurch(existing().get('churchId', '')) || inChurch(existing().get('churchId', ''))) &&
                    incoming().get('churchId', '') == existing().get('churchId', '');
      allow delete: if isSignedIn() && leadsChurch(existing().get('churchId', ''));
    }

    // 7. Visitantes: Isolamento Estrito
    match /visitors/{visitorId} {
      allow read: if isSuperAdmin() || inChurch(existing().get('churchId', ''));
      allow create: if isValidId(visitorId) &&
                    incoming().id == visitorId &&
                    (isSuperAdmin() || inChurch(incoming().get('churchId', '')));
      allow update: if isValidId(visitorId) &&
                    incoming().id == existing().id &&
                    incoming().get('churchId', '') == existing().get('churchId', '') &&
                    (isSuperAdmin() || inChurch(existing().get('churchId', '')));
      allow delete: if leadsChurch(existing().get('churchId', ''));
    }

    // 8. Atendimentos Pastorais
    match /appointments/{appointmentId} {
      allow read: if isSuperAdmin() || inChurch(existing().get('churchId', ''));
      allow create: if isValidId(appointmentId) &&
                    incoming().id == appointmentId &&
                    (isSuperAdmin() || inChurch(incoming().get('churchId', '')));
      allow update: if isValidId(appointmentId) &&
                    incoming().id == existing().id &&
                    incoming().get('churchId', '') == existing().get('churchId', '') &&
                    (isSuperAdmin() || inChurch(existing().get('churchId', '')));
      allow delete: if leadsChurch(existing().get('churchId', ''));
    }

    // 9. Eventos / Agenda
    match /events/{eventId} {
      allow read: if isSuperAdmin() || inChurch(existing().get('churchId', ''));
      allow create: if isValidId(eventId) &&
                    incoming().id == eventId &&
                    (isSuperAdmin() || inChurch(incoming().get('churchId', '')));
      allow update: if isValidId(eventId) &&
                    incoming().id == existing().id &&
                    incoming().get('churchId', '') == existing().get('churchId', '') &&
                    (isSuperAdmin() || inChurch(existing().get('churchId', '')));
      allow delete: if isSuperAdmin() || leadsChurch(existing().get('churchId', ''));
    }

    // 10. Escalas
    match /schedules/{scheduleId} {
      allow read: if isSuperAdmin() || inChurch(existing().get('churchId', ''));
      allow create: if isValidId(scheduleId) && isValidSchedule(incoming()) &&
                    incoming().id == scheduleId &&
                    (isSuperAdmin() || inChurch(incoming().churchId) || leadsChurch(incoming().churchId));
      allow update: if isValidId(scheduleId) && isValidSchedule(incoming()) &&
                    incoming().churchId == existing().churchId &&
                    (isSuperAdmin() || inChurch(existing().churchId) || leadsChurch(existing().churchId) || (existing().members.hasAny([request.auth.uid]) && inChurch(existing().churchId)));
      allow delete: if leadsChurch(existing().get('churchId', '')) || isSuperAdmin();
    }

    // 11. Playlists
    match /playlists/{playlistId} {
      allow read: if isSuperAdmin() || inChurch(existing().get('churchId', ''));
      allow create: if isValidId(playlistId) && isValidPlaylist(incoming()) &&
                    incoming().id == playlistId &&
                    (isSuperAdmin() || inChurch(incoming().churchId) || leadsChurch(incoming().churchId));
      allow update: if isValidId(playlistId) && isValidPlaylist(incoming()) &&
                    incoming().churchId == existing().churchId &&
                    (isSuperAdmin() || inChurch(existing().churchId) || leadsChurch(existing().churchId));
      allow delete: if leadsChurch(existing().get('churchId', '')) || isSuperAdmin();
    }

    // 12. Tokens FCM e códigos
    match /fcm_tokens/{tokenId} {
      allow read, write: if isSignedIn() && (tokenId == request.auth.uid || isSuperAdmin());
    }

    match /verification_codes/{userId} {
      allow read, write: if isSignedIn() && (userId == request.auth.uid || isSuperAdmin());
    }

    match /password_resets/{userId} {
      allow read, write: if false;
    }

    // 13. Disponibilidade
    match /availability/{availId} {
      function isValidAvailability(data) {
        return data.keys().hasAll(['id', 'userId', 'churchId', 'month', 'year', 'days']) &&
               data.id is string &&
               data.userId is string &&
               data.churchId is string &&
               data.month is int && data.month >= 0 && data.month <= 12 &&
               data.year is int && data.year >= 2020 && data.year <= 2100 &&
               data.days is list && data.days.size() <= 40;
      }

      allow read: if isSuperAdmin() ||
                     (isSignedIn() && ('userId' in existing()) && existing().userId == request.auth.uid) ||
                     inChurch(existing().get('churchId', ''));

      allow write: if isSignedIn() && (
        isSuperAdmin() ||
        (isValidAvailability(incoming()) &&
         availId == incoming().id &&
         incoming().userId == request.auth.uid &&
         inChurch(incoming().churchId))
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (('userId' in existing()) && existing().userId == request.auth.uid)
      );
    }

    // 14. Transmissões (Broadcasts)
    match /broadcasts/{broadcastId} {
      function isValidBroadcast(data) {
        return data.keys().hasAll(['id', 'churchId', 'senderId', 'title', 'body', 'status', 'createdAt']) &&
               data.id is string &&
               data.churchId is string &&
               data.senderId is string &&
               data.title is string && data.title.size() <= 200 &&
               data.body is string && data.body.size() <= 2000 &&
               data.status in ['sent', 'cancelled'];
      }

      allow read: if isSuperAdmin() ||
                     (isSignedIn() && ('senderId' in existing()) && existing().senderId == request.auth.uid) ||
                     inChurch(existing().get('churchId', ''));

      allow create: if isSignedIn() && isValidBroadcast(incoming()) &&
                    incoming().id == broadcastId &&
                    incoming().senderId == request.auth.uid &&
                    inChurch(incoming().churchId);

      allow update: if isSignedIn() && isValidBroadcast(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().churchId == existing().churchId &&
                    incoming().senderId == existing().senderId &&
                    (isSuperAdmin() || (existing().senderId == request.auth.uid && inChurch(existing().churchId)) || leadsChurch(existing().churchId));

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (existing().senderId == request.auth.uid && inChurch(existing().churchId)) ||
        leadsChurch(existing().churchId)
      );

      match /readReceipts/{readUserId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (readUserId == request.auth.uid || isSuperAdmin());
      }
    }

    // 15. Feed de Comunicados
    match /announcements/{announcementId} {
      function isValidAnnouncement(data) {
        return data.keys().hasAll(['id', 'churchId', 'authorId', 'title', 'content', 'createdAt']) &&
               data.id is string &&
               data.churchId is string &&
               data.authorId is string &&
               data.title is string && data.title.size() <= 200 &&
               data.content is string && data.content.size() <= 5000 &&
               (!('category' in data) || data.category is string) &&
               (!('isPinned' in data) || data.isPinned is bool) &&
               (!('authorName' in data) || data.authorName is string) &&
               (!('authorRole' in data) || data.authorRole is string) &&
               (!('authorPhotoURL' in data) || data.authorPhotoURL is string) &&
               (!('targetAudience' in data) || data.targetAudience is string) &&
               (!('tags' in data) || data.tags is list);
      }

      allow read: if isSuperAdmin() || inChurch(existing().get('churchId', ''));

      allow create: if isSignedIn() &&
                    isValidAnnouncement(incoming()) &&
                    incoming().id == announcementId &&
                    inChurch(incoming().churchId) &&
                    (incoming().authorId == request.auth.uid || isSuperAdmin());

      allow update: if isSignedIn() &&
                    isValidAnnouncement(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().churchId == existing().churchId &&
                    inChurch(existing().churchId) &&
                    (isSuperAdmin() || existing().authorId == request.auth.uid || leadsChurch(existing().churchId));

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (existing().authorId == request.auth.uid && inChurch(existing().churchId)) ||
        leadsChurch(existing().churchId)
      );
    }

    // 16. Notificações
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        (('userId' in existing()) && existing().userId == request.auth.uid) ||
        (('senderId' in existing()) && existing().senderId == request.auth.uid) ||
        (('churchId' in existing()) && existing().churchId != '' && leadsChurch(existing().churchId))
      );

      allow create: if isSignedIn() &&
                    isValidNotification(incoming()) &&
                    incoming().id == notificationId;

      allow update: if isSignedIn() && (
        (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read'])) ||
        (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'readAt'])) ||
        (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'readAt', 'status'])) ||
        (existing().get('senderId', '') == request.auth.uid) ||
        isSuperAdmin()
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        (('userId' in existing()) && existing().userId == request.auth.uid) ||
        (('senderId' in existing()) && existing().senderId == request.auth.uid) ||
        (('churchId' in existing()) && existing().churchId != '' && leadsChurch(existing().churchId))
      );
    }

    // 17. Logs de Auditoria
    match /audit_logs/{auditId} {
      function isValidAuditLog(data) {
        return data.keys().hasAll(['id', 'actor_user_id', 'action', 'entity_type', 'entity_id', 'church_id', 'created_at']) &&
               data.id is string &&
               data.actor_user_id is string &&
               data.action in ['CREATE', 'UPDATE', 'DELETE'] &&
               data.entity_type is string &&
               data.entity_id is string &&
               data.church_id is string;
      }

      allow read: if isSuperAdmin() ||
                     (('church_id' in existing()) && inChurch(existing().church_id) && isLeader());

      allow create: if isSignedIn() &&
                    isValidAuditLog(incoming()) &&
                    incoming().id == auditId &&
                    (isSuperAdmin() || (inChurch(incoming().church_id) && (incoming().actor_user_id == request.auth.uid || isLeader())));

      allow update, delete: if false;
    }

    // 18. Configurações Globais
    match /system_settings/{settingId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // 19. Mensagens de Contato
    match /contact_messages/{messageId} {
      function isValidContactMessage(data) {
        return data.keys().hasAll(['id', 'name', 'email', 'subject', 'message', 'status']) &&
               data.id is string && isValidId(data.id) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
               data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
               data.subject is string && data.subject.size() > 0 && data.subject.size() <= 250 &&
               data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
               data.status in ['new', 'read', 'in_progress', 'resolved', 'archived'] &&
               (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
               (!('churchName' in data) || (data.churchName is string && data.churchName.size() <= 150)) &&
               (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
               (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
               (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 2000)) &&
               (!('createdAt' in data) || (data.createdAt is timestamp || data.createdAt is string)) &&
               (!('updatedAt' in data) || (data.updatedAt is timestamp || data.updatedAt is string)) &&
               (!('resolvedAt' in data) || (data.resolvedAt is timestamp || data.resolvedAt is string));
      }

      allow read: if isSuperAdmin();
      allow create: if isValidContactMessage(incoming()) && incoming().id == messageId;
      allow update, delete: if isSuperAdmin();
    }
  }
}
