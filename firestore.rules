rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Secure user data helper: Handles missing user document gracefully
    function myData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {"role": "", "churchId": ""};
    }

    function isSuperAdmin() {
      return isSignedIn() && ('super_admin' in request.auth.token) && request.auth.token.super_admin == true;
    }

    function isAdmin() {
      return isSignedIn() && 
             (
               isSuperAdmin() ||
               (('email' in request.auth.token) && request.auth.token.email == 'pedrohenriqueribei@gmail.com') ||
               myData().get('role', '') == 'líder'
             );
    }

    function getMyChurch() {
      return myData().get('churchId', '');
    }

    function hasDepartmentRole(churchId, departmentId, roleString) {
      let path = /databases/$(database)/documents/churches/$(churchId)/departments/$(departmentId)/members/$(request.auth.uid);
      return exists(path) && get(path).data.roles.hasAny([roleString]);
    }

    function isValidNotification(data) {
      let requiredFields = ['id', 'userId', 'title', 'body', 'type', 'read', 'createdAt'];
      return data.keys().hasAll(requiredFields) &&
             data.id is string &&
             data.userId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.body is string && data.body.size() <= 1000 &&
             data.type is string &&
             data.read is bool;
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             (!('status' in data) || data.status in ['active', 'inactive']) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
             (!('vocalRange' in data) || (data.vocalRange is string)) &&
             (!('level' in data) || (data.level is string)) &&
             (!('churchId' in data) || (data.churchId is string)) &&
             (!('role' in data) || (data.role is string)) &&
             (!('roles' in data) || (data.roles is map)) &&
             (!('instruments' in data) || (data.instruments is list && data.instruments.size() <= 60)) &&
             (!('createdAt' in data) || (data.createdAt is string || data.createdAt is timestamp));
    }

    function isValidSong(data) {
      let requiredFields = ['id', 'title', 'artist', 'key', 'link', 'ownerId', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredFields) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.artist is string && data.artist.size() > 0 && data.artist.size() <= 200 &&
             data.key is string && data.key.size() > 0 && data.key.size() <= 20 &&
             data.link is string && data.link.size() > 0 && data.link.size() <= 500 &&
             data.ownerId == request.auth.uid &&
             (!('churchId' in data) || (data.churchId is string)) &&
             (!('sheet' in data) || (data.sheet is string && data.sheet.size() <= 10000)) &&
             (!('bpm' in data) || (data.bpm is string && data.bpm.size() <= 10)) &&
             (!('timeSignature' in data) || (data.timeSignature is string && data.timeSignature.size() <= 20)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
             (!('observations' in data) || (data.observations is string && data.observations.size() <= 2000));
    }

    // --- Match Blocks ---

    match /churches/{churchId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /departments/{departmentId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (isAdmin() || getMyChurch() == churchId);
        
        match /members/{memberUid} {
          function isValidMember(data) {
            return data.keys().hasAll(['userId', 'roles']) &&
                   data.userId is string &&
                   data.roles is list && data.roles.size() <= 20 &&
                   (!('joinedAt' in data) || data.joinedAt is string);
          }

          allow read: if isSignedIn() && (
             memberUid == request.auth.uid ||
             isAdmin() || 
             getMyChurch() == churchId ||
             hasDepartmentRole(churchId, departmentId, 'leader')
          );
          
          allow create: if isSignedIn() && isValidMember(incoming()) && 
             incoming().userId == memberUid &&
             (
               isAdmin() || 
               hasDepartmentRole(churchId, departmentId, 'leader') || 
               getMyChurch() == churchId // Allow any church member to join for now depending on your exact business rule
             );

          allow update: if isSignedIn() && isValidMember(incoming()) &&
             incoming().userId == existing().userId &&
             (
               isAdmin() || 
               hasDepartmentRole(churchId, departmentId, 'leader')
             );

          allow delete: if isSignedIn() && (
             isAdmin() || 
             hasDepartmentRole(churchId, departmentId, 'leader')
          );
        }
      }
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /songs/{songId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource != null && (
          resource.data.ownerId == request.auth.uid ||
          (resource.data.get('churchId', '') != '' && resource.data.get('churchId', '') == getMyChurch())
        ))
      );
      
      allow create: if isSignedIn() && isValidId(songId) && isValidSong(incoming()) && 
                    incoming().id == songId && incoming().createdAt == request.time && 
                    incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(songId) && resource.data.ownerId == request.auth.uid && 
                    isValidSong(incoming()) && incoming().createdAt == existing().createdAt && 
                    incoming().updatedAt == request.time && incoming().ownerId == existing().ownerId &&
                    incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(songId) && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /services/{serviceId} {
      allow read, write: if isSignedIn();
    }

    match /bands/{bandId} {
      allow read, write: if isSignedIn();
    }

    match /visitors/{visitorId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        (resource != null && resource.data.get('churchId', '') != '' && resource.data.get('churchId', '') == getMyChurch())
      );
      allow create: if isSignedIn() && isValidId(visitorId) && incoming().id == visitorId;
      allow update: if isSignedIn() && isValidId(visitorId) && existing().id == incoming().id;
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        (resource != null && (
          (resource.data.get('churchId', '') != '' && resource.data.get('churchId', '') == getMyChurch()) ||
          resource.data.get('personId', '') == request.auth.uid
        ))
      );
      allow create: if isSignedIn() && isValidId(appointmentId) && incoming().id == appointmentId;
      allow update: if isSignedIn() && isValidId(appointmentId) && existing().id == incoming().id;
      allow delete: if isAdmin();
    }

    function isValidSchedule(data) {
      let requiredFields = ['id', 'date', 'churchId', 'songs', 'members', 'roles'];
      return data.keys().hasAll(requiredFields) &&
             data.id is string &&
             data.date is string &&
             data.churchId is string &&
             data.songs is list &&
             data.members is list &&
             data.roles is map;
    }

    match /schedules/{scheduleId} {
      allow read: if isSignedIn() && (
        isAdmin() || (resource != null && resource.data.churchId == getMyChurch())
      );
      allow create: if isSignedIn() && isValidId(scheduleId) && 
                    isValidSchedule(incoming()) && 
                    incoming().id == scheduleId &&
                    (incoming().churchId == getMyChurch() || isAdmin());
      allow update: if isSignedIn() && isValidId(scheduleId) && 
                    isValidSchedule(incoming()) && 
                    (existing().churchId == getMyChurch() || isAdmin()) &&
                    (incoming().churchId == existing().churchId || isAdmin());
      allow delete: if isAdmin();
    }

    match /fcm_tokens/{tokenId} {
      allow read, write: if isSignedIn() && (tokenId == request.auth.uid || isAdmin());
    }

    match /availability/{availId} {
      function isValidAvailability(data) {
        let requiredFields = ["id", "userId", "churchId", "month", "year", "days"];
        return data.keys().hasAll(requiredFields) &&
               data.id is string &&
               data.userId == request.auth.uid &&
               data.churchId is string &&
               data.month is int &&
               data.year is int &&
               data.days is list;
      }

      allow get: if isSignedIn() && (
        availId.split('_')[0] == request.auth.uid || 
        isAdmin() ||
        (resource != null && resource.data.churchId == getMyChurch())
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        resource.data.churchId == getMyChurch() ||
        resource.data.userId == request.auth.uid
      );
      
      allow write: if isSignedIn() && isValidAvailability(incoming()) && 
                    (availId == incoming().id);
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isAdmin() || (resource != null && resource.data.userId == request.auth.uid));
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) &&
                    isValidNotification(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
                    incoming().id == existing().id &&
                    incoming().userId == existing().userId;
      allow create: if isSignedIn() && 
                    isValidNotification(incoming()) &&
                    incoming().id == notificationId &&
                    (
                      isAdmin() || 
                      myData().get('role', '') == 'líder' ||
                      (('email' in request.auth.token) && request.auth.token.email == 'pedrohenriqueribei@gmail.com') ||
                      (
                        getMyChurch() != '' && 
                        exists(/databases/$(database)/documents/users/$(incoming().userId)) &&
                        getMyChurch() == get(/databases/$(database)/documents/users/$(incoming().userId)).data.get('churchId', '')
                      )
                    );
      allow delete: if isAdmin();
    }
  }
}
