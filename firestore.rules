rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Identity helpers ---

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource != null ? request.resource.data : {};
    }

    function existing() {
      return resource != null ? resource.data : {};
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function myEmail() {
      return (isSignedIn() && 'email' in request.auth.token) ? request.auth.token.email : '';
    }

    function myData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(path) ? get(path).data : {};
    }

    function myChurch() {
      return myData().get('churchId', '');
    }

    function myRoles() {
      return myData().get('roles', {});
    }

    function isSuperAdmin() {
      return isSignedIn() &&
             ('super_admin' in request.auth.token) &&
             request.auth.token.super_admin == true;
    }

    // Privileged role names. Anything listed here cannot be self-assigned.
    function leaderRoles() {
      return ['leader', 'multimedia_leader', 'dance_leader'];
    }

    function isLeader() {
      return isSignedIn() && (
        isSuperAdmin() ||
        myData().get('role', '') == 'líder' ||
        myRoles().get('worship', []).hasAny(leaderRoles()) ||
        myRoles().get('multimedia', []).hasAny(leaderRoles()) ||
        myRoles().get('secretariat', []).hasAny(leaderRoles()) ||
        myRoles().get('dance', []).hasAny(leaderRoles())
      );
    }

    function inChurch(churchId) {
      return isSignedIn() && churchId is string && churchId != '' && myChurch() == churchId;
    }

    function leadsChurch(churchId) {
      return isSuperAdmin() || (isLeader() && inChurch(churchId));
    }

    function grantsLeadership(rolesMap) {
      return rolesMap.get('worship', []).hasAny(leaderRoles()) ||
             rolesMap.get('multimedia', []).hasAny(leaderRoles()) ||
             rolesMap.get('secretariat', []).hasAny(leaderRoles()) ||
             rolesMap.get('dance', []).hasAny(leaderRoles());
    }

    // --- Validation helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             (!('status' in data) || data.status in ['active', 'inactive']) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
             (!('vocalRange' in data) || (data.vocalRange is string)) &&
             (!('level' in data) || (data.level is string)) &&
             (!('churchId' in data) || (data.churchId is string)) &&
             (!('role' in data) || (data.role is string)) &&
             (!('roles' in data) || (data.roles is map)) &&
             (!('instruments' in data) || (data.instruments is list && data.instruments.size() <= 60)) &&
             (!('danceStyles' in data) || (data.danceStyles is list && data.danceStyles.size() <= 60)) &&
             (!('danceGroups' in data) || (data.danceGroups is list && data.danceGroups.size() <= 60)) &&
             (!('fcmTokens' in data) || (data.fcmTokens is list && data.fcmTokens.size() <= 50)) &&
             (!('createdAt' in data) || (data.createdAt is string || data.createdAt is timestamp));
    }

    function isValidSong(data) {
      let requiredFields = ['id', 'title', 'artist', 'key', 'link', 'ownerId', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredFields) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.artist is string && data.artist.size() > 0 && data.artist.size() <= 200 &&
             data.key is string && data.key.size() > 0 && data.key.size() <= 20 &&
             data.link is string && data.link.size() > 0 && data.link.size() <= 500 &&
             data.ownerId == request.auth.uid &&
             (!('churchId' in data) || (data.churchId is string)) &&
             (!('sheet' in data) || (data.sheet is string && data.sheet.size() <= 10000)) &&
             (!('bpm' in data) || (data.bpm is string && data.bpm.size() <= 10)) &&
             (!('timeSignature' in data) || (data.timeSignature is string && data.timeSignature.size() <= 20)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
             (!('observations' in data) || (data.observations is string && data.observations.size() <= 2000));
    }

    function isValidSchedule(data) {
      return data.keys().hasAll(['id', 'date', 'churchId', 'songs', 'members', 'roles']) &&
             data.id is string &&
             data.date is string &&
             data.churchId is string &&
             data.songs is list &&
             data.members is list &&
             data.roles is map &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
             (!('multimediaNotes' in data) || (data.multimediaNotes is string && data.multimediaNotes.size() <= 5000));
    }

    function isValidPlaylist(data) {
      return data.keys().hasAll(['id', 'scheduleId', 'churchId', 'songs']) &&
             data.id is string &&
             data.scheduleId is string &&
             data.churchId is string &&
             data.songs is list;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'body', 'type', 'read', 'createdAt']) &&
             data.id is string &&
             data.userId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.body is string && data.body.size() <= 1000 &&
             data.type is string &&
             data.read is bool;
    }

    // --- Collections ---

    match /churches/{churchId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if leadsChurch(churchId);
      allow delete: if isSuperAdmin();

      match /departments/{departmentId} {
        allow read: if isSignedIn() && (isSuperAdmin() || inChurch(churchId));
        allow write: if leadsChurch(churchId);

        match /members/{memberUid} {
          function isValidMember(data) {
            return data.keys().hasAll(['userId', 'roles']) &&
                   data.userId is string &&
                   data.roles is list && data.roles.size() <= 20 &&
                   (!('danceStyles' in data) || (data.danceStyles is list && data.danceStyles.size() <= 60)) &&
                   (!('joinedAt' in data) || data.joinedAt is string || data.joinedAt is timestamp);
          }

          allow read: if isSignedIn() && (
            isSuperAdmin() ||
            memberUid == request.auth.uid ||
            inChurch(churchId)
          );

          // Self-enrolment is allowed, but never with a leadership role.
          allow create: if isValidMember(incoming()) &&
                        incoming().userId == memberUid && (
                          leadsChurch(churchId) ||
                          (isOwner(memberUid) &&
                           inChurch(churchId) &&
                           !incoming().roles.hasAny(leaderRoles()))
                        );

          allow update: if isValidMember(incoming()) &&
                        incoming().userId == existing().userId && (
                          leadsChurch(churchId) ||
                          (isOwner(memberUid) &&
                           !incoming().roles.hasAny(leaderRoles()) &&
                           !existing().roles.hasAny(leaderRoles()))
                        );

          allow delete: if leadsChurch(churchId);
        }
      }
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isValidUser(incoming()) && (
        isSuperAdmin() ||
        (isLeader() && inChurch(incoming().get('churchId', ''))) ||
        (isOwner(userId) &&
         incoming().uid == userId &&
         incoming().get('role', '') != 'líder' &&
         incoming().get('role', '') != 'super_admin' &&
         !grantsLeadership(incoming().get('roles', {})))
      );

      // A leader may only act on members already in their church, or on
      // unlinked users they are pulling into it.
      allow update: if isValidUser(incoming()) && (
        isSuperAdmin() ||
        (isLeader() &&
         (existing().get('churchId', '') == myChurch() || existing().get('churchId', '') == '') &&
         (incoming().get('churchId', '') == myChurch() || incoming().get('churchId', '') == '')) ||
        (isOwner(userId) &&
         incoming().uid == existing().get('uid', incoming().uid) &&
         incoming().get('churchId', '') == existing().get('churchId', '') &&
         incoming().get('email', '') == existing().get('email', '') &&
         incoming().get('status', 'active') == existing().get('status', 'active') &&
         incoming().get('role', '') == existing().get('role', '') &&
         !grantsLeadership(incoming().get('roles', {})))
      );

      allow delete: if isSuperAdmin() ||
                    (isLeader() && inChurch(existing().get('churchId', '')));
    }

    match /songs/{songId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && isValidId(songId) && isValidSong(incoming()) &&
                    incoming().id == songId &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;

      allow update: if isSignedIn() && isValidId(songId) && isValidSong(incoming()) &&
                    existing().ownerId == request.auth.uid &&
                    incoming().ownerId == existing().ownerId &&
                    incoming().id == existing().id &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time;

      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperAdmin());
    }

    // Scale-config documents are read anonymously by the public registration form.
    match /services/{serviceId} {
      allow read: if isSignedIn() ||
                     serviceId.matches('^(worship|multimedia)_scale_config_.+');
      allow create: if leadsChurch(incoming().get('churchId', ''));
      allow update: if leadsChurch(existing().get('churchId', '')) &&
                    incoming().get('churchId', '') == existing().get('churchId', '');
      allow delete: if leadsChurch(existing().get('churchId', ''));
    }

    match /bands/{bandId} {
      allow read: if isSignedIn();
      allow create: if leadsChurch(incoming().get('churchId', ''));
      allow update: if leadsChurch(existing().get('churchId', '')) &&
                    incoming().get('churchId', '') == existing().get('churchId', '');
      allow delete: if leadsChurch(existing().get('churchId', ''));
    }

    match /dance_groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if leadsChurch(incoming().get('churchId', ''));
      allow update: if leadsChurch(existing().get('churchId', '')) &&
                    incoming().get('churchId', '') == existing().get('churchId', '');
      allow delete: if leadsChurch(existing().get('churchId', ''));
    }

    match /choreographies/{choreographyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (leadsChurch(incoming().get('churchId', '')) || inChurch(incoming().get('churchId', '')));
      allow update: if isSignedIn() && (leadsChurch(existing().get('churchId', '')) || inChurch(existing().get('churchId', '')));
      allow delete: if isSignedIn() && (leadsChurch(existing().get('churchId', '')) || inChurch(existing().get('churchId', '')));
    }

    match /dance_rehearsals/{rehearsalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (leadsChurch(incoming().get('churchId', '')) || inChurch(incoming().get('churchId', '')));
      allow update: if isSignedIn() && (leadsChurch(existing().get('churchId', '')) || inChurch(existing().get('churchId', '')));
      allow delete: if isSignedIn() && (leadsChurch(existing().get('churchId', '')) || inChurch(existing().get('churchId', '')));
    }

    match /visitors/{visitorId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || inChurch(existing().get('churchId', ''))
      );
      allow create: if isValidId(visitorId) &&
                    incoming().id == visitorId &&
                    (isSuperAdmin() || inChurch(incoming().get('churchId', '')));
      allow update: if isValidId(visitorId) &&
                    incoming().id == existing().id &&
                    incoming().get('churchId', '') == existing().get('churchId', '') &&
                    (isSuperAdmin() || inChurch(existing().get('churchId', '')));
      allow delete: if leadsChurch(existing().get('churchId', ''));
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        inChurch(existing().get('churchId', '')) ||
        existing().get('personId', '') == request.auth.uid
      );
      allow create: if isValidId(appointmentId) &&
                    incoming().id == appointmentId &&
                    (isSuperAdmin() || inChurch(incoming().get('churchId', '')));
      allow update: if isValidId(appointmentId) &&
                    incoming().id == existing().id &&
                    incoming().get('churchId', '') == existing().get('churchId', '') &&
                    (isSuperAdmin() || inChurch(existing().get('churchId', '')));
      allow delete: if leadsChurch(existing().get('churchId', ''));
    }

    match /schedules/{scheduleId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || inChurch(existing().get('churchId', ''))
      );
      allow create: if isValidId(scheduleId) && isValidSchedule(incoming()) &&
                    incoming().id == scheduleId &&
                    (isSuperAdmin() || inChurch(incoming().churchId));
      allow update: if isValidId(scheduleId) && isValidSchedule(incoming()) &&
                    incoming().churchId == existing().churchId &&
                    (isSuperAdmin() || inChurch(existing().churchId));
      allow delete: if leadsChurch(existing().get('churchId', ''));
    }

    match /playlists/{playlistId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || inChurch(existing().get('churchId', ''))
      );
      allow create: if isValidId(playlistId) && isValidPlaylist(incoming()) &&
                    incoming().id == playlistId &&
                    (isSuperAdmin() || inChurch(incoming().churchId));
      allow update: if isValidId(playlistId) && isValidPlaylist(incoming()) &&
                    incoming().churchId == existing().churchId &&
                    (isSuperAdmin() || inChurch(existing().churchId));
      allow delete: if leadsChurch(existing().get('churchId', ''));
    }

    match /fcm_tokens/{tokenId} {
      allow read, write: if isSignedIn() && (tokenId == request.auth.uid || isSuperAdmin());
    }

    match /availability/{availId} {
      function isValidAvailability(data) {
        return data.keys().hasAll(['id', 'userId', 'churchId', 'month', 'year', 'days']) &&
               data.id is string &&
               data.userId is string &&
               data.churchId is string &&
               data.month is int && data.month >= 0 && data.month <= 12 &&
               data.year is int && data.year >= 2020 && data.year <= 2100 &&
               data.days is list && data.days.size() <= 40;
      }

      allow read: if isSignedIn();

      // The document id is namespaced by uid, so a member can only write their own.
      allow write: if isSignedIn() && (
        isSuperAdmin() ||
        (isValidAvailability(incoming()) &&
         availId == incoming().id &&
         incoming().userId == request.auth.uid &&
         availId.split('_')[0] == request.auth.uid)
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin() ||
        availId.split('_')[0] == request.auth.uid
      );
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || existing().userId == request.auth.uid
      );

      allow create: if isSignedIn() &&
                    isValidNotification(incoming()) &&
                    incoming().id == notificationId;

      allow update: if isSignedIn() &&
                    (existing().userId == request.auth.uid || isSuperAdmin()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']);

      allow delete: if isSignedIn() && (
        isSuperAdmin() || existing().userId == request.auth.uid
      );
    }
  }
}
