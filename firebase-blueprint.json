{
  "entities": {
    "User": {
      "title": "Usuário",
      "description": "Perfil de integrante ou administrador",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "instruments": { "type": "array", "items": { "type": "string" } },
        "vocalRange": { "type": "string" },
        "level": { "type": "string" },
        "churchId": { "type": "string", "description": "ID da igreja/ministério relacionada" },
        "roles": {
          "type": "object",
          "properties": {
            "worship": { "type": "array", "items": { "type": "string" } },
            "multimedia": { "type": "array", "items": { "type": "string" } },
            "secretariat": { "type": "array", "items": { "type": "string" } }
          }
        },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "fcmTokens": { "type": "array", "items": { "type": "string" }, "description": "Tokens FCM para notificações push" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "status"]
    },
    "Visitor": {
      "title": "Visitante",
      "description": "Visitante da congregação",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "firstVisit": { "type": "string", "format": "date-time" },
        "followupStatus": { "type": "string", "enum": ["pending", "contacted", "member"] },
        "churchId": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "churchId", "followupStatus"]
    },
    "Appointment": {
      "title": "Atendimento Pastoral",
      "description": "Agendamento de gabinete",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "churchId": { "type": "string" },
        "personId": { "type": "string", "description": "UID do usuário ou ID do visitante" },
        "personName": { "type": "string" },
        "pastorId": { "type": "string" },
        "type": { "type": "string", "enum": ["counseling", "prayer", "visit", "other"] },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "churchId", "personId", "personName", "type", "scheduledAt", "status"]
    },
    "Church": {
      "title": "Igreja",
      "description": "Congregação do ministério",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "pastor": { "type": "string" },
        "worshipMinistryName": { "type": "string" },
        "worshipMinistryAcronym": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "Band": {
      "title": "Banda",
      "description": "Banda interna de um ministério",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "churchId": { "type": "string" },
        "memberIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "churchId", "memberIds"]
    },
    "Song": {
      "title": "Música",
      "description": "Repertório musical do usuário",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "key": { "type": "string" },
        "link": { "type": "string" },
        "sheet": { "type": "string", "description": "Cifra da música" },
        "bpm": { "type": "string" },
        "timeSignature": { "type": "string", "description": "Compasso" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "observations": { "type": "string" },
        "ownerId": { "type": "string", "description": "UID do usuário que cadastrou" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "artist", "key", "link", "ownerId"]
    },
    "Schedule": {
      "title": "Escala",
      "description": "Planejamento de louvor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "churchId": { "type": "string" },
        "songs": { "type": "array" },
        "members": { "type": "array" },
        "roles": { "type": "object" },
        "rehearsalDate": { "type": "string", "description": "Data do ensaio" },
        "rehearsalTime": { "type": "string", "description": "Hora do ensaio" },
        "playlist": { "type": "array", "items": { "type": "string" }, "description": "Lista de IDs de músicas da playlist pessoal do ministro" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "churchId"]
    },
    "Playlist": {
      "title": "Playlist",
      "description": "Conjunto de músicas escaladas para estudo e ensaio",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID coincide com o ID da escala (1-para-1)" },
        "scheduleId": { "type": "string" },
        "churchId": { "type": "string" },
        "songs": { "type": "array", "items": { "type": "string" }, "description": "Array de IDs das músicas vinculadas" },
        "rehearsalDate": { "type": "string" },
        "rehearsalTime": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "scheduleId", "churchId", "songs"]
    },
    "Availability": {
      "title": "Disponibilidade",
      "description": "Dias disponíveis de um integrante no mês",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "userId_year_month" },
        "userId": { "type": "string" },
        "churchId": { "type": "string" },
        "month": { "type": "integer" },
        "year": { "type": "integer" },
        "days": { "type": "array", "items": { "type": "integer" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "churchId", "month", "year", "days"]
    },
    "Notification": {
      "title": "Notificação",
      "description": "Alertas e avisos para o usuário",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "body", "read", "createdAt"]
    },
    "Department": {
      "title": "Departamento",
      "description": "Departamentos ou Ministérios de uma igreja",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "churchId": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "churchId", "name"]
    },
    "DepartmentMember": {
      "title": "Membro do Departamento",
      "description": "Participante de um departamento com escopo de papéis",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "ID do membro = UID do usuário" },
        "roles": { "type": "array", "items": { "type": "string" }, "description": "Lista de papéis (ex: leader, musician, member)" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "roles"]
    },
    "Service": {
      "title": "Culto",
      "description": "Culto ou celebração da congregação",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "churchId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "dayOfWeek": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "churchId", "name", "startTime", "endTime", "dayOfWeek"]
    }
  },
  "firestore": {
    "users/{userId}": { "schema": "User", "description": "Perfis de usuários" },
    "churches/{churchId}": { "schema": "Church", "description": "Listagem de igrejas" },
    "churches/{churchId}/departments/{departmentId}": { "schema": "Department", "description": "Departamentos da Igreja" },
    "churches/{churchId}/departments/{departmentId}/members/{userUid}": { "schema": "DepartmentMember", "description": "Papéis dos membros escopados no respectivo departamento" },
    "services/{serviceId}": { "schema": "Service", "description": "Cultos e celebrações da congregação" },
    "visitors/{visitorId}": { "schema": "Visitor", "description": "Visitantes" },
    "appointments/{appointmentId}": { "schema": "Appointment", "description": "Atendimentos" },
    "songs/{songId}": { "schema": "Song", "description": "Repertório musical" },
    "schedules/{scheduleId}": { "schema": "Schedule", "description": "Escalas de louvor" },
    "availability/{availableId}": { "schema": "Availability", "description": "Disponibilidade dos membros" },
    "notifications/{notificationId}": { "schema": "Notification", "description": "Notificações internas do sistema" },
    "bands/{bandId}": { "schema": "Band", "description": "Bandas internas dos ministérios" },
    "playlists/{playlistId}": { "schema": "Playlist", "description": "Playlists independentes vinculadas às respectivas escalas de louvor" }
  }
}
