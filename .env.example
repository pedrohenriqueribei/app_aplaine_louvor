# URL pública da aplicação (usada em metadataBase / Open Graph)
NEXT_PUBLIC_SITE_URL=

# Chave pública VAPID do Firebase Cloud Messaging
# Console > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_VAPID_KEY=

# Chave da API Gemini (server-side)
GEMINI_API_KEY=

# Segredo de bootstrap para POST /api/set-super-admin
# Deixe vazio para desabilitar o acesso por header X-Setup-Secret
ADMIN_SETUP_SECRET=

# Somente fora do Google Cloud (Vercel, Docker, local):
# caminho do JSON da service account do Firebase Admin SDK.
# No Cloud Run / App Hosting isso vem das Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
